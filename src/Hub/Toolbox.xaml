<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowFill}" TextElement.FontFamily="Segoe UI" TextElement.FontSize="14"
      TextElement.Foreground="{DynamicResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="WindowFill" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="SurfaceFill" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderFill" Color="#17263E"/>
    <SolidColorBrush x:Key="RailFill" Color="#EAF0F7"/>
    <SolidColorBrush x:Key="NavHover" Color="#EDF2FB"/>
    <SolidColorBrush x:Key="NavSelected" Color="#DDE9FE"/>
    <SolidColorBrush x:Key="NavInk" Color="#1749A9"/>
    <SolidColorBrush x:Key="ControlLine" Color="#BFD1EF"/>
    <SolidColorBrush x:Key="ControlHover" Color="#98B2D9"/>
    <SolidColorBrush x:Key="GripBrush" Color="#849AB7"/>
    <SolidColorBrush x:Key="CheckRing" Color="#6B81A1"/>
    <SolidColorBrush x:Key="RowHover" Color="#F0F5FC"/>
    <SolidColorBrush x:Key="DisabledFill" Color="#F0F3F7"/>
    <SolidColorBrush x:Key="DisabledLine" Color="#CAD3E0"/>
    <SolidColorBrush x:Key="HeaderInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryFill" Color="#2256B4"/>
    <SolidColorBrush x:Key="PrimaryInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryLine" Color="#2256B4"/>
    <SolidColorBrush x:Key="PinkAccent" Color="#B62F74"/>
    <SolidColorBrush x:Key="ModeFill" Color="#2D4566"/>
    <SolidColorBrush x:Key="Ink" Color="#233C43"/>
    <SolidColorBrush x:Key="Muted" Color="#526D73"/>
    <SolidColorBrush x:Key="Line" Color="#D4E6E4"/>
    <SolidColorBrush x:Key="Accent" Color="#007F83"/>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="0,0,0,5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="Button">
      <!-- Rounding inside the scaled button can clip the last pixel of its outline. -->
      <Setter Property="UseLayoutRounding" Value="False"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource ControlHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryLine}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryInk}"/>
    </Style>
    <Style x:Key="Navigation" TargetType="RadioButton">
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="NavSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="10">
              <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource NavHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource NavSelected}"/>
                <Setter Property="Foreground" Value="{DynamicResource NavInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RailNavigation" TargetType="RadioButton" BasedOn="{StaticResource Navigation}">
      <Setter Property="Tag" Value="{DynamicResource RailExpanded}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="HorizontalContentAlignment" Value="Left"/>
          <Setter Property="Padding" Value="10,10"/>
          <Setter Property="Margin" Value="5,0,10,7"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RailNavLabel" TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style x:Key="Field" TargetType="StackPanel">
      <Setter Property="MaxWidth" Value="{DynamicResource FieldMaxWidth}"/>
    </Style>
    <DataTemplate x:Key="RuleTemplate">
      <Border Style="{StaticResource Surface}" Padding="14" Margin="0,0,0,10">
        <StackPanel>
          <WrapPanel>
            <CheckBox Content="Enabled" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,14,8"/>
            <Button Content="Remove rule" Tag="{Binding}" Margin="0,0,0,8"/>
          </WrapPanel>
          <WrapPanel>
            <StackPanel Width="216" Margin="0,0,12,10" Style="{StaticResource Field}"><Label Target="{Binding ElementName=RuleTitle}">Event title contains</Label><TextBox x:Name="RuleTitle" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Width="106" Margin="0,0,12,10"><Label Target="{Binding ElementName=RuleDays}">Weekdays</Label><TextBox x:Name="RuleDays" Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Width="105" Margin="0,0,12,10"><Label Target="{Binding ElementName=RuleTime}">Ready by</Label><TextBox x:Name="RuleTime" Text="{Binding Ready, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Width="171" Margin="0,0,12,10">
              <Label Target="{Binding ElementName=RuleMode}">Policy</Label>
              <ComboBox x:Name="RuleMode" SelectedValuePath="Content" SelectedValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="Confirmed dates"/><ComboBoxItem Content="Recurring"/>
              </ComboBox>
            </StackPanel>
          </WrapPanel>
          <Label Target="{Binding ElementName=RuleDates}"><TextBlock Text="Confirmed dates (YYYY-MM-DD, separated by commas)"/></Label>
          <TextBox x:Name="RuleDates" Text="{Binding Dates, UpdateSourceTrigger=PropertyChanged}" Width="560" MaxWidth="{DynamicResource FieldMaxWidth}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
      <Setter Property="ResizeDirection" Value="Columns"/>
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="{TemplateBinding Background}">
              <Border x:Name="Grip" Width="3" Height="30" Background="{DynamicResource GripBrush}" CornerRadius="1.5"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ResultToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="RowSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <DockPanel>
                <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,4,9,0">
                  <Ellipse x:Name="Ring" Fill="White" Stroke="{DynamicResource CheckRing}" StrokeThickness="1.5"/>
                  <Ellipse x:Name="Dot" Fill="{DynamicResource Accent}" Width="9" Height="9" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource RowHover}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource NavSelected}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource DisabledFill}"/>
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource DisabledLine}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ResultTemplate">
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <ToggleButton Style="{StaticResource ResultToggle}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding CanApply}" AutomationProperties.Name="{Binding SelectionLabel}"
                      ToolTip="{Binding Reason}" ToolTipService.ShowOnDisabled="True">
          <StackPanel>
            <WrapPanel VerticalAlignment="Center">
              <Border Padding="8,4" CornerRadius="5" Background="{Binding StatusBackground}" Margin="0,0,10,5">
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold" FontSize="12"/>
              </Border>
              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,6"/>
            </WrapPanel>
            <TextBlock Text="{Binding Schedule}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}"/>
          </StackPanel>
        </ToggleButton>
      </Border>
    </DataTemplate>
  </Grid.Resources>

  <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="65" MinWidth="55" MaxWidth="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.ColumnSpan="2" Background="{DynamicResource HeaderFill}" BorderBrush="{DynamicResource PinkAccent}" BorderThickness="0,0,0,3" Padding="21,10">
    <StackPanel>
    <DockPanel LastChildFill="True">
      <Border x:Name="ModeBadge" DockPanel.Dock="Right" Visibility="Collapsed" Background="{DynamicResource ModeFill}" Padding="8,4" Margin="8,0,0,0" CornerRadius="5" VerticalAlignment="Center">
        <TextBlock x:Name="ModeText" Foreground="{DynamicResource HeaderInk}" FontSize="12" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Text="Thong Khong Toolbox" Foreground="{DynamicResource HeaderInk}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{DynamicResource SurfaceFill}" BorderBrush="{DynamicResource ControlLine}"
            BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,10,0,2">
      <StackPanel>
        <TextBlock x:Name="UpdateBannerText" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Margin="0,6,0,0">
          <Button x:Name="StartupUpdateNow" Content="Update now" Style="{StaticResource PrimaryButton}" Margin="0,2,8,2"/>
          <Button x:Name="DismissUpdate" Content="Later" Margin="0,2,0,2"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    </StackPanel>
  </Border>
  <Border x:Name="ToolRail" Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource RailFill}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Line}">
    <StackPanel x:Name="Navigation" Margin="0,13,0,0">
      <RadioButton x:Name="HomeNav" ToolTip="Home" AutomationProperties.Name="Home"
                   GroupName="HubViews" Style="{StaticResource RailNavigation}" IsChecked="True">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE80F;" Style="{StaticResource NavGlyph}" Width="20"/>
          <TextBlock Text="Home" Style="{StaticResource RailNavLabel}"/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="SlingNav" ToolTip="Sling Shift Auto Apply" AutomationProperties.Name="Sling Shift Auto Apply"
                   GroupName="HubViews" Style="{StaticResource RailNavigation}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE787;" Style="{StaticResource NavGlyph}" Width="20"/>
          <TextBlock Text="Auto Apply" Style="{StaticResource RailNavLabel}"/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="WinOptNav" ToolTip="WinOpt storage maintenance" AutomationProperties.Name="WinOpt"
                   GroupName="HubViews" Style="{StaticResource RailNavigation}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xEDA2;" Style="{StaticResource NavGlyph}" Width="20"/>
          <TextBlock Text="WinOpt" Style="{StaticResource RailNavLabel}"/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="SettingsNav" ToolTip="Toolbox Settings" AutomationProperties.Name="Toolbox Settings"
                   GroupName="HubViews" Style="{StaticResource RailNavigation}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}" Width="20"/>
          <TextBlock Text="Settings" Style="{StaticResource RailNavLabel}"/>
        </StackPanel>
      </RadioButton>
    </StackPanel>
  </Border>
  <GridSplitter x:Name="NavigationSplitter" Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" Panel.ZIndex="1"
                Style="{StaticResource PaneSplitter}" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                ResizeBehavior="CurrentAndNext" ToolTip="Drag to resize the navigation sidebar" AutomationProperties.Name="Resize navigation sidebar"/>
  <Grid x:Name="Heading" Grid.Row="1" Grid.Column="1" Margin="20,15,20,5" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Column="0" x:Name="HeadingText">
      <TextBlock Text="Sling Shift Auto Apply" FontSize="29" FontWeight="SemiBold"/>
      <TextBlock Text="Google Calendar availability and Sling applications" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
    </StackPanel>
    <Border x:Name="HeadingActions" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="6" Margin="14,0,0,0">
      <WrapPanel>
        <Button x:Name="PreviewButton" Content="Preview matches" MinHeight="44" Margin="4"/>
        <Button x:Name="ApplyButton" Content="Auto apply" Style="{StaticResource PrimaryButton}" MinHeight="44" Margin="4"/>
      </WrapPanel>
    </Border>
    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
      <RadioButton x:Name="WeekNav" Content="Week" GroupName="SlingViews" Style="{StaticResource Navigation}" IsChecked="True"/>
      <RadioButton x:Name="RulesNav" Content="Rules" GroupName="SlingViews" Style="{StaticResource Navigation}"/>
      <RadioButton x:Name="ResultsNav" Content="Results" GroupName="SlingViews" Style="{StaticResource Navigation}"/>
    </WrapPanel>
  </Grid>
  <Grid x:Name="Pages" Grid.Row="2" Grid.Column="1" Margin="20,0">
    <ContentControl x:Name="WinOptPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,22,8,12">
<WrapPanel x:Name="AppsHeader" Margin="0,0,0,12" Orientation="Horizontal">
            <TextBlock x:Name="AppsTitle" Text="Apps" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,6"/>
            <Border x:Name="AppViewSwitch" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,6"
                    Background="{DynamicResource SurfaceFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="3">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AppGridView" Content="Grid" GroupName="AppView" IsChecked="True"
                             AutomationProperties.Name="Grid view" Style="{StaticResource Navigation}" Margin="0,0,2,0"/>
                <RadioButton x:Name="AppListView" Content="List" GroupName="AppView"
                             AutomationProperties.Name="List view" Style="{StaticResource Navigation}" Margin="0"/>
              </StackPanel>
            </Border>
          </WrapPanel>
          <ItemsControl x:Name="AppCatalog" Tag="{Binding IsChecked, ElementName=AppGridView}">
            <ItemsControl.Style>
              <Style TargetType="ItemsControl">
                <Setter Property="ItemsPanel">
                  <Setter.Value><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="ItemsPanel">
                      <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button x:Name="AppCard" Command="{Binding Open}" AutomationProperties.Name="{Binding Name}"
                        ToolTip="{Binding Detail}" HorizontalContentAlignment="Stretch" Padding="12"
                        Margin="0,0,0,10">
                  <DockPanel>
                    <Border x:Name="AppIcon" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8"
                            Background="{DynamicResource NavSelected}" Margin="0,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Icon}" Style="{StaticResource NavGlyph}"
                                 Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="AppName" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock x:Name="AppDetail" Text="{Binding Detail}" Style="{StaticResource Caption}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter TargetName="AppCard" Property="Width" Value="{DynamicResource AppTileSize}"/>
                    <Setter TargetName="AppCard" Property="Height" Value="{DynamicResource AppTileSize}"/>
                    <Setter TargetName="AppCard" Property="Margin" Value="0,0,12,12"/>
                    <Setter TargetName="AppIcon" Property="DockPanel.Dock" Value="Top"/>
                    <Setter TargetName="AppIcon" Property="HorizontalAlignment" Value="Center"/>
                    <Setter TargetName="AppIcon" Property="Margin" Value="0,0,0,12"/>
                    <Setter TargetName="AppName" Property="TextAlignment" Value="Center"/>
                    <Setter TargetName="AppDetail" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="MikuHomeStickers" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,8,0,4" Padding="14,6">
            <TextBlock FontFamily="Segoe UI Symbol" FontSize="42" AutomationProperties.Name="Music, heart, and flower decorations"><Run Text="♪  " Foreground="{DynamicResource Accent}"/><Run Text="♡  ✿" Foreground="{DynamicResource PinkAccent}"/></TextBlock>
          </Border>
          <Border Style="{StaticResource Surface}" Padding="16" Margin="0,12,0,0"
                  MaxWidth="350" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="Connected accounts" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="HomeGoogleStatus" Style="{StaticResource Caption}" Margin="0,2,0,3"/>
              <TextBlock x:Name="HomeSlingStatus" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
              <Button x:Name="OpenSettings" Content="Manage accounts" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border x:Name="WeekPage" Style="{StaticResource Surface}" Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="12,10,12,3">
          <Button x:Name="PreviousWeek" Content="‹" AutomationProperties.Name="Previous week" Padding="11,5" MinHeight="32" Margin="0,0,5,5"/>
          <Button x:Name="NextWeek" Content="›" AutomationProperties.Name="Next week" Padding="11,5" MinHeight="32" Margin="0,0,10,5"/>
          <TextBlock x:Name="WeekText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,5"/>
          <RadioButton x:Name="CalendarMode" GroupName="ScheduleLayout" Content="Calendar" Style="{StaticResource Navigation}" IsChecked="True"/>
          <RadioButton x:Name="AgendaMode" GroupName="ScheduleLayout" Content="Agenda" Style="{StaticResource Navigation}"/>
        </WrapPanel>
        <StackPanel Grid.Row="1" Margin="13,1,12,7">
          <WrapPanel x:Name="Legend"/>
        </StackPanel>
        <ContentControl x:Name="ScheduleHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
    </Border>

    <ScrollViewer x:Name="RulesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,6,8">
        <Border x:Name="CalendarRuleCard" Style="{StaticResource Surface}" Padding="15" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Calendars that block work" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="CalendarRuleStatus" Style="{StaticResource Caption}" Margin="0,1,0,9"/>
            <Button x:Name="LoadCalendars" Content="Load calendars" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <ItemsControl x:Name="CalendarChoices"/>
          </StackPanel>
        </Border>
        <TextBlock Text="Class exceptions" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Ready by includes travel. Leave weekdays blank to match any day." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
        <ItemsControl x:Name="RuleList" ItemTemplate="{StaticResource RuleTemplate}"/>
        <WrapPanel Margin="0,2,0,0">
          <Button x:Name="AddRule" Content="Add rule" Margin="0,0,8,5"/>
          <Button x:Name="SaveRules" Content="Save rules" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"/>
        </WrapPanel>
        <Border Style="{StaticResource Surface}" Padding="15" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Demo mode" Style="{StaticResource SectionTitle}"/>
            <CheckBox x:Name="Demo" Margin="0,4,0,0"><TextBlock Text="Use sample schedules and simulate applications"/></CheckBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="ResultsPage" Style="{StaticResource Surface}" Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="14,13,14,10">
          <TextBlock Text="Match results" Style="{StaticResource SectionTitle}"/>
          <TextBlock x:Name="ResultSummary" Text="Choose Preview matches to load your options." Style="{StaticResource Caption}"/>
        </StackPanel>
        <Grid Grid.Row="1" x:Name="ResultsLayout">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition x:Name="ChecklistColumn" Width="330" MinWidth="240"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="ChecklistRow" Height="0"/></Grid.RowDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="ResultWeekText" FontWeight="SemiBold" Margin="12,2,8,7"/>
            <WrapPanel x:Name="ResultLegend" Grid.Row="1" Margin="12,0,6,4"/>
            <ContentControl x:Name="ResultScheduleHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          </Grid>
          <GridSplitter x:Name="ChecklistSplitter" Grid.Column="1" Panel.ZIndex="1" Style="{StaticResource PaneSplitter}"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndCurrent"
                        ToolTip="Drag to resize the shift checklist" AutomationProperties.Name="Resize shift checklist"/>
          <Border x:Name="ChecklistPanel" Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel Margin="12,0,10,6">
                <TextBlock Text="Shift checklist" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="CheckedCount" Style="{StaticResource Caption}"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button x:Name="SelectEligible" Content="Select all eligible" Padding="9,4" MinHeight="28" Margin="0,0,6,4"/>
                  <Button x:Name="ClearSelection" Content="Clear selection" Padding="9,4" MinHeight="28" Margin="0,0,0,4"/>
                </WrapPanel>
              </StackPanel>
              <ItemsControl x:Name="ResultList" Grid.Row="1" ItemTemplate="{StaticResource ResultTemplate}"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.Template>
                  <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,22,8,12" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Toolbox Settings" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="Connect once to use your accounts across the Toolbox." Style="{StaticResource Caption}" Margin="0,0,0,18"/>
        <Border Style="{StaticResource Surface}" Padding="15" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Miku theme" Style="{StaticResource SectionTitle}"/>
            <CheckBox x:Name="MikuPinkTheme" Content="Miku teal + pink" Margin="0,4,0,10"/>
            <CheckBox x:Name="MikuArtwork" Content="Show original Miku art and decorations" Margin="0,0,0,10"/>
            <WrapPanel x:Name="MikuArtworkPreview" Visibility="Collapsed">
              <Image x:Name="MikuSettingsPicture" Width="200" Height="200" Stretch="Uniform" Margin="0,0,12,8" AutomationProperties.Name="Original Hatsune Miku illustration by KEI"/>
              <StackPanel Width="280" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe UI Symbol" FontSize="42" Margin="0,0,0,12"><Run Text="♪  " Foreground="{DynamicResource Accent}"/><Run Text="♡  ✿" Foreground="{DynamicResource PinkAccent}"/></TextBlock>
                <TextBlock Text="Hatsune Miku © Crypton Future Media, Inc. 2007 · Art by KEI" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <Button x:Name="MikuSettingsCredit" Content="Artwork source · CC BY-NC 3.0" HorizontalAlignment="Left" FontSize="12"/>
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Surface}" Padding="15" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Google Calendar" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="GoogleStatus" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
            <WrapPanel>
              <Button x:Name="ConnectGoogle" Content="Connect Google…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,7"/>
              <Button x:Name="DisconnectGoogle" Content="Disconnect Google" Margin="0,0,8,7"/>
              <Button x:Name="OpenCalendarRules" Content="Choose calendars for Sling" Margin="0,0,0,7"/>
            </WrapPanel>
            <Expander x:Name="GoogleSignInSetup" Header="Google OAuth setup" Margin="0,4,0,8">
              <StackPanel Margin="0,8,0,0">
                <TextBlock x:Name="GoogleAppStatus" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <Label Target="{Binding ElementName=GoogleAppId}">Desktop OAuth client ID</Label>
                <TextBox x:Name="GoogleAppId" Width="480" MaxWidth="{DynamicResource FieldMaxWidth}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <Label Target="{Binding ElementName=GoogleAppSecret}">Desktop OAuth client secret</Label>
                <PasswordBox x:Name="GoogleAppSecret" Width="480" MaxWidth="{DynamicResource FieldMaxWidth}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Button x:Name="SaveGoogleApp" Content="Save sign-in setup" Margin="0,0,8,5"/>
                  <Button x:Name="GoogleCloudClients" Content="Open Google Cloud" Margin="0,0,0,5"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Surface}" Padding="15" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Sling" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="SlingStatus" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
            <WrapPanel>
              <StackPanel Width="242" Margin="0,0,12,10" Style="{StaticResource Field}"><Label Target="{Binding ElementName=Email}">Sling email</Label><TextBox x:Name="Email"/></StackPanel>
              <StackPanel Width="212" Margin="0,0,0,10" Style="{StaticResource Field}"><Label Target="{Binding ElementName=Password}">Password</Label><PasswordBox x:Name="Password"/></StackPanel>
            </WrapPanel>
            <WrapPanel>
              <StackPanel Width="294" Margin="0,0,12,10" Style="{StaticResource Field}"><Label Target="{Binding ElementName=SlingToken}"><TextBlock Text="Authorization token (Sling or Toast sign-in)"/></Label><PasswordBox x:Name="SlingToken"/></StackPanel>
              <StackPanel Width="169" Margin="0,0,0,10"><Label Target="{Binding ElementName=Organization}"><TextBlock Text="Organization ID (optional)"/></Label><TextBox x:Name="Organization"/></StackPanel>
            </WrapPanel>
            <WrapPanel>
              <Button x:Name="ConnectSling" Content="Connect Sling" Style="{StaticResource PrimaryButton}" Margin="0,0,8,5"/>
              <Button x:Name="DisconnectSling" Content="Disconnect Sling" Margin="0,0,0,5"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Surface}" Padding="15" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="ToolboxVersion" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
            <TextBlock Text="Toolbox checks for updates when it starts. You choose when to download and restart." Style="{StaticResource Caption}" Margin="0,0,0,9"/>
            <WrapPanel>
              <Button x:Name="CheckForUpdates" Content="Check for updates" Margin="0,0,8,5"/>
              <Button x:Name="InstallUpdate" Content="Update now" Style="{StaticResource PrimaryButton}" Margin="0,0,8,5" Visibility="Collapsed"/>
              <Button x:Name="OpenLatestRelease" Content="View release downloads" Margin="0,0,0,5" Visibility="Collapsed"/>
            </WrapPanel>
            <TextBlock x:Name="UpdateCheckStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="3" Grid.Column="1" Style="{StaticResource Caption}" Margin="20,8,20,10"/>
</Grid>
