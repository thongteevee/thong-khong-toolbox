<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowFill}" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontSize="14" UseLayoutRounding="True">
  <Grid.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="WinOptMuted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="AdvancedOnly" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceFill}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#BF4375"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryInk}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceFill}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="UseLayoutRounding" Value="False"/>
      <Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,7,4"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceFill}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" CornerRadius="13" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NavHover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NavSelected}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ControlHover}"/><Setter Property="Foreground" Value="{DynamicResource NavInk}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#BF4375"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid KeyboardNavigation.TabNavigation="Local">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0" Margin="0,2,2,3"/>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="2"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="True"/>
      <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EBEFF5"/>
      <Setter Property="RowHeight" Value="34"/><Setter Property="Background" Value="{DynamicResource SurfaceFill}"/>
      <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="22,14" Background="{DynamicResource HeaderFill}" BorderBrush="{DynamicResource PinkAccent}" BorderThickness="0,0,0,3">
    <StackPanel>
      <TextBlock Text="WinOpt" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource HeaderInk}"/>
      <TextBlock Text="Read-only duplicate discovery. Your files stay as they are." Foreground="{DynamicResource HeaderInk}" Margin="0,4,0,0"/>
    </StackPanel>
  </Border>
  <TabControl x:Name="Sections" Grid.Row="1" Margin="18,14,18,10" Background="Transparent" BorderThickness="0">
    <TabItem Header="Storage">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,16,10,0">
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Find matching contents" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Compare files in folders you choose. Names and ages do not determine duplicates. No files are deleted, moved, renamed or changed." Style="{StaticResource WinOptMuted}" Margin="0,8,0,14"/>
            <Button x:Name="OpenDuplicates" Content="Find duplicate files" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <DockPanel Margin="0,0,0,10"><Button x:Name="RefreshDrives" Content="Read drive information" DockPanel.Dock="Right"/>
            <TextBlock Text="Your drives" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <ItemsControl x:Name="Drives"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Card}"><StackPanel>
              <DockPanel><TextBlock Text="{Binding Media}" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding Volume}" FontSize="20" FontWeight="SemiBold"/></DockPanel>
              <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8" Margin="0,10,0,10" Foreground="{DynamicResource Accent}"/>
              <WrapPanel><TextBlock Text="{Binding Free, StringFormat={}{0} free}" Margin="0,0,18,0"/><TextBlock Text="{Binding Used, StringFormat={}{0} used}" Margin="0,0,18,0"/><TextBlock Text="{Binding Capacity, StringFormat={}{0} capacity}"/></WrapPanel>
            </StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <WrapPanel><Button x:Name="TaskManager" Content="Task Manager"/><Button x:Name="StartupApps" Content="Startup apps"/><Button x:Name="InstalledApps" Content="Installed apps"/></WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Duplicate files">
      <Grid Margin="2,12,2,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="Scope">
          <WrapPanel><Button x:Name="AddFolder" Content="Choose folder…"/><Button x:Name="UnselectFolder" Content="Unselect folder"/><CheckBox x:Name="Subfolders" Content="Include subfolders" IsChecked="True" VerticalAlignment="Center" Margin="4,0,0,8"/></WrapPanel>
          <ListBox x:Name="Folders" Height="70" AutomationProperties.Name="Folders selected for read-only scanning"/>
          <Expander Header="Excluded paths" Margin="0,8,0,8"><StackPanel>
            <TextBlock Text="Optional: one full local path per line. Files and subfolders at those paths are skipped." Style="{StaticResource WinOptMuted}"/>
            <TextBox x:Name="Exclusions" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Excluded paths"/>
          </StackPanel></Expander>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
          <Button x:Name="Scan" Content="Find duplicate contents" Style="{StaticResource Primary}" HorizontalAlignment="Left" IsEnabled="False"/>
          <TextBlock x:Name="Summary" Text="Choose folders, then find duplicate contents. No file is selected for removal." FontWeight="SemiBold"/>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ListBox x:Name="Groups" Margin="0,0,8,0" AutomationProperties.Name="Matching content groups">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <DataGrid x:Name="Matches" Grid.Column="1" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Matching files, read only">
            <DataGrid.Columns>
              <DataGridTextColumn Header="File path" Binding="{Binding Path}" Width="*" MinWidth="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="85"/>
              <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=g}" Width="135"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
          <TextBlock x:Name="GroupDescription" Text="Choose a matching group to review its files." Style="{StaticResource WinOptMuted}"/>
          <TextBox x:Name="SelectedPath" IsReadOnly="True" TextWrapping="Wrap" MinHeight="30" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Selected file full path"/>
          <TextBlock Text="Matching content does not mean a file is unwanted. This tool has no delete or cleanup action." Style="{StaticResource WinOptMuted}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="Scan details">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,16,10,0">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Latest scan" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="Outcome" Text="No duplicate scan yet." Margin="0,12,0,0"/>
        </StackPanel></Border>
        <TextBlock Text="The scan reads only selected local folders. Links, cloud placeholders, inaccessible files and files that change while reading are skipped. Scans stop at 100,000 inspected entries and can be cancelled." Style="{StaticResource WinOptMuted}"/>
        <TextBlock Text="Possible matches are filtered by length, hashed with SHA-256, then compared byte for byte. Results describe content at scan time. No filename history or scan results are saved to disk or uploaded." Style="{StaticResource WinOptMuted}" Margin="0,12,0,0"/>
        <TextBlock Text="No age-based cleanup, file deletion, automatic keep/remove choices, or claimed recovered space." Style="{StaticResource WinOptMuted}" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer>
    </TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceFill}" Padding="20,10">
    <DockPanel><Button x:Name="Cancel" DockPanel.Dock="Right" Content="Cancel scan" IsEnabled="False" Margin="10,0,0,0"/>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="Ready. Choose a folder to scan. Files will not be changed." FontSize="12"/><ProgressBar x:Name="Progress" Height="3" Margin="0,6,0,0" Foreground="{DynamicResource Accent}"/></StackPanel>
    </DockPanel>
  </Border>
</Grid>