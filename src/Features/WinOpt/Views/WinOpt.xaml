<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowFill}" TextElement.Foreground="{DynamicResource Ink}" TextElement.FontSize="14" UseLayoutRounding="True">
  <Grid.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="WinOptMuted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="AdvancedOnly" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceFill}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#BF4375"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryInk}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceFill}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="UseLayoutRounding" Value="False"/>
      <Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,7,4"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceFill}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" CornerRadius="13" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NavHover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource NavSelected}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource ControlHover}"/><Setter Property="Foreground" Value="{DynamicResource NavInk}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#BF4375"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid KeyboardNavigation.TabNavigation="Local">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0" Margin="0,2,2,3"/>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="2"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="True"/>
      <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EBEFF5"/>
      <Setter Property="RowHeight" Value="34"/><Setter Property="Background" Value="{DynamicResource SurfaceFill}"/>
      <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Padding="22,14" Background="{DynamicResource HeaderFill}" BorderBrush="{DynamicResource PinkAccent}" BorderThickness="0,0,0,3">
    <WrapPanel>
      <TextBlock Text="WinOpt" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource HeaderInk}" Margin="0,0,26,0"/>
      <CheckBox x:Name="AdvancedMode" Content="Advanced mode" Foreground="{DynamicResource HeaderInk}" VerticalAlignment="Center" Padding="2"/>
    </WrapPanel>
  </Border>
  <TabControl x:Name="Sections" Grid.Row="1" Margin="18,16,18,10" Background="Transparent" BorderThickness="0">
    <TabItem Header="Storage">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,18,10,0">
          <DockPanel Margin="0,0,0,8">
            <Button x:Name="RefreshDrives" DockPanel.Dock="Right" Content="Refresh"/>
            <TextBlock Text="Your drives" FontSize="22" FontWeight="SemiBold"/>
          </DockPanel>
          <ItemsControl x:Name="Drives">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <DockPanel><TextBlock Text="{Binding Media}" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Style="{StaticResource AdvancedOnly}"/>
                      <TextBlock Text="{Binding Volume}" FontSize="20" FontWeight="SemiBold"/></DockPanel>
                    <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8" Margin="0,12,0,10" Foreground="#24ADA5"/>
                    <WrapPanel>
                      <TextBlock Text="{Binding Free, StringFormat={}{0} free}" FontWeight="SemiBold" Margin="0,0,20,0"/>
                      <TextBlock Text="{Binding Used, StringFormat={}{0} used}" Margin="0,0,20,0"/>
                      <TextBlock Text="{Binding Capacity, StringFormat={}{0} capacity}" Style="{StaticResource WinOptMuted}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Free up space" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <WrapPanel><Button x:Name="OpenCleanup" Content="Temporary files" Style="{StaticResource Primary}"/>
                <Button x:Name="Storage" Content="Storage settings"/><Button x:Name="Recycle" Content="Recycle Bin"/></WrapPanel>
              <WrapPanel Style="{StaticResource AdvancedOnly}"><Button x:Name="Optimize" Content="Optimize drives"/>
                <Button x:Name="Recommendations" Content="Cleanup recommendations"/></WrapPanel>
            </StackPanel>
          </Border>
          <StackPanel Style="{StaticResource AdvancedOnly}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Windows tools" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <WrapPanel><Button x:Name="TaskManager" Content="Task Manager"/><Button x:Name="StartupApps" Content="Startup apps"/><Button x:Name="InstalledApps" Content="Installed apps"/></WrapPanel>
            </StackPanel>
          </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Cleanup">
      <Grid Margin="2,10,2,0">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="FileListRow" Height="400" MinHeight="400"/><RowDefinition Height="12"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel x:Name="Policy">
            <StackPanel x:Name="AdvancedPolicy" Style="{StaticResource AdvancedOnly}">
            <WrapPanel>
              <StackPanel Margin="0,0,20,10"><Label Content="Cleanup mode" Target="{Binding ElementName=Mode}" Padding="0,0,0,5"/>
                <ComboBox x:Name="Mode" SelectedIndex="0" MinWidth="230" Padding="7" AutomationProperties.Name="Cleanup mode">
                  <ComboBoxItem Content="Safe · older than 7 days"/><ComboBoxItem Content="Standard · older than 24 hours"/><ComboBoxItem Content="Aggressive · all eligible files"/>
                </ComboBox></StackPanel>
              <CheckBox x:Name="WindowsTemp" Content="Include Windows Temp" VerticalAlignment="Center" Margin="0,15,0,10" ToolTip="Optional. Inaccessible files are skipped; the hub does not request elevation."/>
            </WrapPanel>
            <TextBlock x:Name="TempLocation" Style="{StaticResource WinOptMuted}" FontSize="12"/>
            <Expander Header="Exclude files or folders" Margin="0,9,0,9">
              <StackPanel><TextBlock Text="One full local path per line. Exclusions apply to every mode. Changing these options requires a new scan." Style="{StaticResource WinOptMuted}" Margin="0,6,0,6"/>
                <TextBox x:Name="Exclusions" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Excluded paths"/></StackPanel>
            </Expander>
            </StackPanel>
          </StackPanel>
          <WrapPanel><Button x:Name="Scan" Content="Scan" Style="{StaticResource Primary}" ToolTip="Preview temporary files. Simple mode uses files older than 7 days."/>
            <Button x:Name="SelectAll" Content="Select all"/><Button x:Name="SelectNone" Content="Clear"/>
            <Button x:Name="ExpandFiles" Content="Expand list"/></WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,9">
          <TextBlock x:Name="PreviewSummary" Text="Scan to find temporary files." FontWeight="SemiBold"/>
          <StackPanel Style="{StaticResource AdvancedOnly}">
          <TextBlock x:Name="Categories" Style="{StaticResource WinOptMuted}" FontSize="12" Margin="0,4,0,0"/>
          <TextBlock x:Name="Skipped" Style="{StaticResource WinOptMuted}" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <DataGrid x:Name="Candidates" Grid.Row="2" MinHeight="400" ColumnHeaderHeight="34" CanUserSortColumns="True" AutomationProperties.Name="Temporary file preview">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Clean" Width="58">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Path, StringFormat=Select {0}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*" MinWidth="180" IsReadOnly="True">
              <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Path}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="155" IsReadOnly="True" Visibility="Collapsed"/>
            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="85" IsReadOnly="True"/>
            <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=g}" Width="140" IsReadOnly="True" Visibility="Collapsed"/>
          </DataGrid.Columns>
        </DataGrid>
        <Thumb x:Name="FileListGrip" Grid.Row="3" Cursor="SizeNS" ToolTip="Drag to resize list" AutomationProperties.Name="Resize file list">
          <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border Width="60" Height="3" CornerRadius="2" Background="{DynamicResource GripBrush}" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template>
        </Thumb>
      </Grid>
      </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
          <WrapPanel>
            <Button x:Name="Clean" Content="Clean selected…" Style="{StaticResource Primary}" IsEnabled="False"/>
            <StackPanel Style="{StaticResource AdvancedOnly}"><Button x:Name="DryRun" Content="Test selection" IsEnabled="False"/></StackPanel>
            <TextBlock x:Name="Selection" FontWeight="SemiBold" Margin="4,10,0,8"/>
          </WrapPanel>
          <TextBlock Text="Selected files are permanently deleted." Style="{StaticResource WinOptMuted}" FontSize="12"/>
        </StackPanel>
      </Grid>
    </TabItem>
    <TabItem Header="Results">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,18,10,0">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Latest result" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="Outcome" Text="No cleanup yet." Margin="0,12,0,0"/>
          <TextBlock x:Name="OutcomeDetails" Style="{StaticResource AdvancedOnly}" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <StackPanel Style="{StaticResource AdvancedOnly}">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="Recent" Margin="0,12,0,0"/>
        </StackPanel></Border>
        <TextBlock Text="Logs stay on this device under %LOCALAPPDATA%\ThongKhongToolbox\WinOpt\Logs. They contain timestamps, counts, logical bytes and error codes; filenames are not recorded. Up to two log files are retained, approximately 1 MiB each." Style="{StaticResource WinOptMuted}"/>
        </StackPanel>
      </StackPanel></ScrollViewer>
    </TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceFill}" Padding="20,10">
    <DockPanel>
      <Button x:Name="Cancel" DockPanel.Dock="Right" Content="Cancel" IsEnabled="False" Margin="10,0,0,0"/>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="Status" Text="Ready" FontSize="12"/>
        <ProgressBar x:Name="Progress" Height="3" Margin="0,6,0,0" Foreground="{DynamicResource Accent}"/></StackPanel>
    </DockPanel>
  </Border>
</Grid>
